{
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "init-ai-api"
      }
    }
  ],
  "services": {
    "init-ai-api": {
      "root": ".",
      "entrypoint": "app.main:app",
      "buildCommand": "pip install -r requirements.txt"
    }
  }
}