# INIT.AI backend configuration.
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon / local / any Postgres).
# Examples:
#   postgresql+psycopg://user:password@localhost:5432/initai
#   postgresql+psycopg://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Comma-separated list of allowed CORS origins (Vite dev server by default).
# Add your deployed frontend, e.g. https://init-ai-ebon.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session cookie: set to true when serving over HTTPS (production / Neon).
SESSION_COOKIE_SECURE=false

# SameSite policy. "lax" (default) works when frontend and API share a site
# (e.g. both on *.vercel.app). Set to "none" for cross-site setups
# (e.g. frontend on Vercel, API on Render).
SESSION_COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# Account / email configuration
# Frontend URL is used to build verification and password-reset links sent
# by email. In development it points at the Vite dev server; in production
# set it to the deployed frontend, e.g. https://init-ai-ebon.vercel.app
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Address shown as the email sender (no SMTP required for development).
EMAIL_FROM=noreply@init.ai
# Token lifetimes (hours)
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
EMAIL_CHANGE_TTL_HOURS=24
# Log emails to stdout instead of delivering via SMTP (development-safe).
EMAIL_LOG_ENABLED=true

# ---------------------------------------------------------------------------
# Stellar attestation verification (Testnet only by policy).
# The backend pins the expected contract id: client-submitted contract ids
# are cross-checked against this value. Horizon is queried read-only for
# transaction verification - no keys or secrets here.
# ---------------------------------------------------------------------------
STELLAR_CONTRACT_ID=CDYHVMVLSKZ4IMVO7DICAJYNVUZMMV6DD252IL2WPWKSX4NC2YII5GQ4
STELLAR_HORIZON_BASE=https://horizon-testnet.stellar.org
STELLAR_NETWORK=testnet
