# Frontend API base URL (FastAPI backend).
# Copy to .env and fill in real values. Never commit .env.
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Stellar / Soroban (report attestations) - TESTNET ONLY, never Mainnet.
# Leave VITE_STELLAR_ENABLED=false (or unset) to ship with all Stellar code
# paths disabled; the rest of INIT.AI is unaffected.
#
# No secrets belong in VITE_* variables: these values are all public
# (contract ids, network names, endpoints). Wallet keys stay inside the
# user's own Freighter extension and are never configured here.
# ---------------------------------------------------------------------------

# Master switch for the Stellar integration.
VITE_STELLAR_ENABLED=false

# Network policy: only "testnet" is supported; any other value disables
# the integration.
VITE_STELLAR_NETWORK=testnet

# Deployed SpatialAttestationRegistry contract id (SOW name + legacy alias).
# Current testnet deployment (2026-08-31, with prev_hash): CDYHVMVLSKZ4IMVO7DICAJYNVUZMMV6DD252IL2WPWKSX4NC2YII5GQ4
VITE_SOROBAN_CONTRACT_ID=CDYHVMVLSKZ4IMVO7DICAJYNVUZMMV6DD252IL2WPWKSX4NC2YII5GQ4
VITE_STELLAR_CONTRACT_ID=CDYHVMVLSKZ4IMVO7DICAJYNVUZMMV6DD252IL2WPWKSX4NC2YII5GQ4

# Soroban RPC endpoint (transaction submission + contract reads).
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Horizon REST endpoint (explorer links / transaction lookups).
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ---------------------------------------------------------------------------
# Production note: builds run with `vercel build --prebuilt`, which pulls
# VITE_* values from the Vercel project environment (dashboard or
# `vercel env add`), NOT from this file. Mirror any real values there.
# ---------------------------------------------------------------------------
