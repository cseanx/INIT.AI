# Frontend API base URL (FastAPI backend).
# Copy to .env to point the frontend at a running backend.
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Stellar / Soroban (report attestations) — Testnet ONLY, never Mainnet.
# Leave VITE_STELLAR_ENABLED=false (or unset) to ship the app with all
# Stellar code paths disabled; the rest of INIT.AI is unaffected.
#
# VITE_STELLAR_CONTRACT_ID — SpatialAttestationRegistry deployed on Testnet.
# Deployed 2026-08-24 via `stellar contract deploy --network testnet`:
#   CBQSI2TXAXWNRBPFT457JVH5IUVWKR72XMNQFTSPHDUWRRV76SBDUBXF
# Explorer: https://stellar.expert/explorer/testnet/contract/CBQSI2TXAXWNRBPFT457JVH5IUVWKR72XMNQFTSPHDUWRRV76SBDUBXF
#
# NOTE: production builds run locally (`vercel build --prebuilt`), so these
# values must also be passed at build time, e.g.:
#   $env:VITE_STELLAR_ENABLED="true"
#   $env:VITE_STELLAR_CONTRACT_ID="<CONTRACT_ID>"
# ---------------------------------------------------------------------------
VITE_STELLAR_ENABLED=false
VITE_STELLAR_CONTRACT_ID=
