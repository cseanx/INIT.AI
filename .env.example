# Frontend API base URL (FastAPI backend).
# Copy to .env and fill in real values. Never commit .env.
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Stellar / Soroban (report attestations)
# Default is TESTNET. Mainnet is an explicit opt-in (real XLM fees).
# Leave VITE_STELLAR_ENABLED=false (or unset) to ship with all Stellar code
# paths disabled; the rest of INIT.AI is unaffected.
#
# No secrets belong in VITE_* variables: these values are all public
# (contract ids, network names, endpoints). Wallet keys stay inside the
# user's own Freighter extension and are never configured here.
# ---------------------------------------------------------------------------

# Master switch for the Stellar integration.
VITE_STELLAR_ENABLED=false

# Initial/default network: "testnet" (default) or "mainnet". The in-app
# header toggle switches at runtime and remembers the choice in localStorage.
VITE_STELLAR_NETWORK=testnet

# Testnet contract (the toggle's Testnet option).
# Current testnet deployment (2026-08-31, with prev_hash):
VITE_SOROBAN_CONTRACT_ID=CDYHVMVLSKZ4IMVO7DICAJYNVUZMMV6DD252IL2WPWKSX4NC2YII5GQ4
VITE_STELLAR_CONTRACT_ID=CDYHVMVLSKZ4IMVO7DICAJYNVUZMMV6DD252IL2WPWKSX4NC2YII5GQ4

# Mainnet contract — set after `deploy-mainnet.ps1` to enable the toggle's
# Mainnet option. Leave blank to ship Testnet-only.
# See contracts/soroban/MAINNET-RUNBOOK.md.
VITE_MAINNET_SOROBAN_CONTRACT_ID=
# VITE_MAINNET_STELLAR_CONTRACT_ID=  # legacy alias, optional

# Endpoint overrides (optional — defaults follow each network).
# General overrides apply to VITE_STELLAR_NETWORK only.
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# VITE_MAINNET_RPC_URL=https://soroban-mainnet.stellar.org
# VITE_MAINNET_HORIZON_URL=https://horizon.stellar.org

# ---------------------------------------------------------------------------
# Production note: builds run with `vercel build --prebuilt`, which pulls
# VITE_* values from the Vercel project environment (dashboard or
# `vercel env add`), NOT from this file. Mirror any real values there.
# ---------------------------------------------------------------------------
