# ═══════════════════════════════════════════════
# INIT.AI Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ═══════════════════════════════════════════════

# ─── Database ──────────────────────────────────
POSTGRES_USER=initai
POSTGRES_PASSWORD=initai_dev_2025
POSTGRES_DB=initai_db

# ─── Backend ───────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_jwt_key_here_minimum_32_characters

# ─── Supabase (get from supabase.com dashboard) ─
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Google Earth Engine ───────────────────────
# Service account email from GEE console
GEE_SERVICE_ACCOUNT=initai@your-project.iam.gserviceaccount.com
# Path to downloaded JSON key file
GEE_KEY_FILE=./gee-key.json

# ─── MapLibre / MapTiler ───────────────────────
# Free key from maptiler.com (free tier: 100k tiles/month)
MAPTILER_KEY=your_maptiler_api_key_here

# ─── Anthropic (AI Chat feature) ──────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Email Alerts (optional) ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@init.ai
SMTP_PASSWORD=your_app_password

# ─── Frontend (Next.js public vars) ───────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_MAPTILER_KEY=${MAPTILER_KEY}
NEXT_PUBLIC_APP_NAME=INIT.AI
NEXT_PUBLIC_APP_VERSION=2.4.1
